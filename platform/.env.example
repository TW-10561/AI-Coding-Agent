# ── Kadavuley Platform Environment ──────────────────────────────────────
# Copy to .env and fill in your values:  cp .env.example .env
 
# Platform server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
 
# OpenCode engine
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_BIN=opencode
OPENCODE_DIR=.
 
# Optional: password-protect the OpenCode server
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=changeme
 
# ── LLM Configuration ───────────────────────────────────────────────
# Point to your vLLM / OpenAI-compatible server:
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL_ID=plezan/MiniMax-M2.1-REAP-50-W4A16
VLLM_MODEL_NAME=plezan/MiniMax-M2.1-REAP-50-W4A16
VLLM_CONTEXT_LIMIT=30000
VLLM_OUTPUT_LIMIT=4096
 
# Platform auth (leave empty for open dev mode)
# PLATFORM_API_KEY=your-platform-key
# PLATFORM_JWT_SECRET=your-jwt-secret
 