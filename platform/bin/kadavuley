#!/usr/bin/env bash
# ── Kadavuley CLI Wrapper ────────────────────────────────────────────
# Usage: kadavuley [--headless] [--tui-only]
# Run from anywhere — auto-detects platform root.
set -euo pipefail

# ── Resolve script location (follow symlinks) ────────────────────────
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PLATFORM_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Ensure bun is in PATH ────────────────────────────────────────────
if ! command -v bun &>/dev/null; then
  for p in "$HOME/.bun/bin" "/usr/local/bin"; do
    [[ -x "$p/bun" ]] && export PATH="$p:$PATH" && break
  done
fi
if ! command -v bun &>/dev/null; then
  echo "  ✗ bun not found. Install: curl -fsSL https://bun.sh/install | bash"
  exit 1
fi

# ── Ensure opencode is in PATH ───────────────────────────────────────
if ! command -v opencode &>/dev/null; then
  for p in "$HOME/.local/bin" "/usr/local/bin" "$PLATFORM_DIR/../packages/opencode/dist/opencode-linux-arm64/bin"; do
    [[ -x "$p/opencode" ]] && export PATH="$p:$PATH" && break
  done
fi

# ── Load .env if present (handle values with spaces) ─────────────────
if [[ -f "$PLATFORM_DIR/.env" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip comments and empty lines
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    # Export the variable
    export "$line" 2>/dev/null || true
  done < "$PLATFORM_DIR/.env"
fi

# ── Run ───────────────────────────────────────────────────────────────
cd "$PLATFORM_DIR"

case "${1:-}" in
  --headless)
    # Run only backend (OpenCode + Platform), no TUI
    exec bun run scripts/start-all.ts
    ;;
  --tui-only)
    # Connect TUI to an existing backend
    exec bun run tui/src/main.ts
    ;;
  *)
    # Full stack: OpenCode + Platform + TUI
    exec bun run scripts/launch.ts
    ;;
esac
