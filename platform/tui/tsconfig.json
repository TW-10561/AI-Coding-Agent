{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["@types/bun"],
    "paths": {
      "@sdk/*": ["../src/sdk/*"],
      "@types/*": ["../src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "../src/sdk/**/*.ts", "../src/types/**/*.ts"]
}
