{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@thirdwave/platform",
  "version": "0.1.0",
  "description": "Production AI coding platform — slim backend + SDK over self-hosted OpenCode",
  "type": "module",
  "private": true,
  "bin": {
    "thirdwave": "./bin/thirdwave"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "start": "bun run src/server/index.ts",
    "start:opencode": "bun run scripts/start-opencode.ts",
    "start:all": "bun run scripts/start-all.ts",
    "launch": "bun run scripts/launch.ts",
    "build": "bun build src/server/index.ts --outdir dist --target bun",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "generate:types": "bun run scripts/generate-types.ts",
    "tui": "bun run tui/src/main.ts",
    "Thirdwave": "bun run tui/src/main.ts"
  },
  "dependencies": {
    "hono": "4.10.7",
    "postgres": "3.4.5",
    "zod": "4.1.8",
    "ulid": "3.0.1",
    "remeda": "2.26.0",
    "opencode-ai": "^1.14.20"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "5.8.2"
  }
}
