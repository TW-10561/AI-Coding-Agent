# ── Thirdwave AI Platform — Environment Template ───────────────────────
# Copy this to platform/.env and fill in values for your new environment.
# Lines starting with # are comments. Uncomment to enable.
#
# REQUIRED fields are marked [REQUIRED] — the platform will NOT start without them.
# OPTIONAL fields have sensible defaults.
# ────────────────────────────────────────────────────────────────────────

# ── Platform Server ───────────────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Multi-user: shift all ports by this offset (0 = default)
THIRDWAVE_PORT_OFFSET=0

# Auto-find a free port if PORT is busy
AUTO_PORT=true

# ── Paths [REQUIRED — update for your new server] ────────────────────
# Project root directory (where the AI-Coding-Agent repo lives)
OPENCODE_DIR=/path/to/AI-Coding-Agent

# OpenCode binary location
OPENCODE_BIN=/home/YOUR_USER/.opencode/bin/opencode

# Agent workspace for generated files (defaults to OPENCODE_DIR/.agent-workspace)
AGENT_WORKSPACE_DIR=/path/to/AI-Coding-Agent/.agent-workspace

# ── TUI Connection ───────────────────────────────────────────────────
THIRDWAVE_URL=http://localhost:3100

# ── OpenCode Engine ──────────────────────────────────────────────────
OPENCODE_URL=http://127.0.0.1:4096

# ── Inference Gateway [REQUIRED — update for twave network] ─────────
# Your vLLM gateway URL on the new network
VLLM_GATEWAY_URL=http://172.30.140.63:9080/v1
VLLM_GATEWAY_KEY=vllm-o0RBaenwnusbD5MRZW4s1IAs3QcUFhUZYnnF_8773Q8

# ── Direct vLLM (optional fallback, bypasses gateway) ───────────────
# VLLM_BASE_URL=http://YOUR_VLLM_GPU_IP:8000/v1
# VLLM_API_KEY=
# VLLM_MODEL_ID=plezan/MiniMax-M2.1-REAP-50-W4A16
# VLLM_CONTEXT_LIMIT=30000
# VLLM_OUTPUT_LIMIT=4096
# Extra vLLM endpoints (comma-separated)
# VLLM_EXTRA_ENDPOINTS=http://gpu2:8001/v1,http://gpu3:8002/v1

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Set POSTGRES_URL to use PostgreSQL. Leave unset to use SQLite (dev mode).
POSTGRES_PORT=5433
# POSTGRES_URL=postgresql://thirdwave:thirdwave_dev@localhost:5433/thirdwave
# PGBOUNCER_URL=postgresql://thirdwave:thirdwave_dev@localhost:6432/thirdwave

# ── Cloud API Keys (all optional — set any to enable that provider) ──
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=AIza...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=fw_...
# OPENROUTER_API_KEY=sk-or-...

# ── Platform Auth (optional — leave empty for open dev mode) ─────────
# PLATFORM_API_KEY=your-platform-key
# PLATFORM_JWT_SECRET=your-jwt-secret
# JWT_SECRET=your-jwt-secret

# ── OpenCode Auth (optional) ─────────────────────────────────────────
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=changeme
