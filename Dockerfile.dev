FROM oven/bun:1.3.10-alpine AS opencode-build
WORKDIR /build
COPY package.json bun.lock* turbo.json ./
RUN mkdir -p packages/opencode packages/script
RUN bun install --frozen-lockfile 2>/dev/null || bun install
RUN if [ -d packages/opencode ] && [ -f packages/opencode/package.json ]; then \
      bun install --cwd packages/opencode && \
      cd packages/opencode && bun run build -- --single --skip-install; \
    fi
FROM oven/bun:1.3.10-alpine AS runtime
RUN apk add --no-cache git ripgrep curl docker-cli gcompat libc6-compat nodejs npm
WORKDIR /app
COPY platform/package.json ./platform/
RUN cd platform && bun install
COPY platform/tui/package.json ./platform/tui/
RUN cd platform/tui && bun install
COPY platform/src ./platform/src
COPY platform/scripts ./platform/scripts
COPY platform/bin ./platform/bin
COPY platform/tui ./platform/tui
COPY platform/HITL ./platform/HITL
COPY platform/util ./platform/util
COPY platform/skills ./platform/skills
COPY platform/tsconfig.json ./platform/
RUN touch ./platform/.env
RUN mkdir -p /workspace/.agent-workspace
WORKDIR /app/platform
ENV PORT=3100
ENV HOST=0.0.0.0
ENV NODE_ENV=development
ENV LOG_LEVEL=debug
ENV OPENCODE_URL=http://127.0.0.1:4096
ENV OPENCODE_BIN=opencode
ENV OPENCODE_DIR=/workspace
EXPOSE 3100 4096
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s \
  CMD wget -qO- http://localhost:3100/health/ready || exit 1
CMD ["bun", "run", "scripts/start-all.ts"]
